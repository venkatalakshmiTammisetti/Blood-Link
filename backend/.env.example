PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bloodlink
DB_PORT=3306

# Mock OTP — logged to backend console; returned as mockOtp in dev API responses
MOCK_OTP=123456

# Max distance in km for matching donors
MATCH_RADIUS_KM=50

# Optional: CORS origin for Socket.io
FRONTEND_URL=http://localhost:5173
